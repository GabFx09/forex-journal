# Salin file ini menjadi ".env" lalu isi nilainya
# cp .env.example .env

# ── Gmail ────────────────────────────────────────────────────────
# Alamat Gmail pengirim (sekaligus penerima jika SEND_TO dikosongkan)
GMAIL_USER=v3662432@gmail.com

# App Password Gmail — BUKAN password biasa akun Google Anda.
# Cara buat: https://myaccount.google.com/apppasswords
# Pastikan 2-Step Verification sudah aktif terlebih dahulu.
# Format: 16 karakter tanpa spasi, contoh: abcdabcdabcdabcd
GMAIL_APP_PASSWORD=isi_app_password_anda_di_sini

# Alamat penerima (opsional — kosongkan jika sama dengan GMAIL_USER)
SEND_TO=

# ── Jadwal ───────────────────────────────────────────────────────
# Jam pengiriman (format 24-jam, default 7 = 07:00)
SEND_HOUR=7
